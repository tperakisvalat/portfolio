# Optional production layer — NOT required for your local trial.
# Fill only after choosing the worker host / DNS target.
# Add these to .env.news.local ON THAT HOST, alongside your OpenAI key.
NEWS_OWNER_ID=""
NEWS_WEB_ORIGIN="https://tpv.world"
NEWS_BACKEND_DOMAIN=""
NEWS_WORKER_ENABLED="false"
# Set true only after restoring data, verifying login, and stopping the old
# worker. This enables manual runs; keep the /admin daily schedule off until the
# first production draft has passed owner review.

# In the EXISTING Vercel project's production environment, set:
# NEWS_BACKEND_URL=https://<the same approved backend domain>
# No OpenAI or Postgres credentials belong in the Vercel front end.
