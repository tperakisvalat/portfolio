# Your one required provider credential. Never prefix it with VITE_.
# Paste it between the quotes, save, then run: npm run news:start
OPENAI_API_KEY=""

# Optional: existing public portfolio config. Setup copies these from .env.local
# if present. They are NOT needed for the standalone news desk.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# No database password, owner UUID, market trading key, or search key is needed
# for the local stack. Setup generates its private infrastructure credentials.
# Production deployment uses a separate, explicit target approval.
