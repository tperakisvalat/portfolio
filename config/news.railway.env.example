# API-only migration stage. Paste into the news-api service's Railway Variables.
# The database service must be named Postgres for these references to resolve.
NODE_ENV=production
RAILWAY_DOCKERFILE_PATH=Dockerfile.railway-api
PORT=8080
NEWS_MANAGED_DB=railway-dedicated
DATABASE_URL=${{Postgres.DATABASE_URL}}
NEWS_DB_HOST=${{Postgres.RAILWAY_PRIVATE_DOMAIN}}
NEWS_DB_NAME=${{Postgres.PGDATABASE}}
NEWS_WORKER_ENABLED=false
NEWS_LOCAL_DESK=false

# Copy these three values from the existing local configuration, not new keys.
NEWS_OWNER_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Exact frontend HTTPS origin; use the Vercel preview URL during testing.
NEWS_WEB_ORIGIN=

# Do NOT add OPENAI_API_KEY, NEWS_LOCAL_ADMIN_TOKEN, NEWS_EXECUTOR_URL or
# NEWS_EXECUTOR_TOKEN yet. The API refuses them until worker isolation is built.
# Railway injects RAILWAY_PROJECT_ID and RAILWAY_ENVIRONMENT_ID automatically.
