FROM node:24-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS build
COPY src ./src
COPY shared ./shared
COPY index.html vite.config.js ./
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_NEWS_LOCAL_DESK=true
RUN npm run build

FROM dependencies AS executor
ENV NODE_ENV=production NEWS_EXECUTOR_CONTAINER=true
COPY server ./server
COPY shared ./shared
USER node
CMD ["node", "--import", "tsx", "server/executor.ts"]

FROM dependencies AS desk
ENV NODE_ENV=production
COPY server ./server
COPY shared ./shared
COPY supabase/migrations ./supabase/migrations
COPY docs/news ./docs/news
COPY --from=build /app/dist ./dist
USER node
CMD ["node", "--import", "tsx", "server/standalone.ts"]
