# Supabase Configuration (Frontend - public keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# News backend only. Never use a VITE_ prefix for secrets.
# Omit DATABASE_URL for the embedded local database.
DATABASE_URL=
OPENAI_API_KEY=
# Exact Supabase Auth user UUID allowed to administer news.
NEWS_OWNER_ID=
NEWS_WEB_ORIGIN=https://tpv.world
NEWS_API_PORT=8787
# Random development-only token; in-memory browser entry, never shipped in the bundle.
NEWS_LOCAL_ADMIN_TOKEN=
# Enable only after isolated worker + provider/delegation/metering tests pass.
NEWS_WORKER_ENABLED=false
NEWS_WORKER_ISOLATED=false
NEWS_PRICING_FILE=docs/news/pricing.example.json
